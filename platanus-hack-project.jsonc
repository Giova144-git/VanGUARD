{
  // Your project's name, as it will appear on the voting page.
  "project-name": "VanGUARD",

  // Short one-line summary of your project (in Spanish).
  "project-oneliner-spanish": "Conecta tu repo de GitHub, tu Supabase y tu Cloudflare: VanGUARD audita tu ecosistema, revisa cada push y te avisa al instante por WhatsApp con el arreglo listo para tu IA.",

  // Brief description of your project (in Spanish).
  "project-description-spanish": "VanGUARD es un panel de seguridad para startups que viven en la nube. Con tokens de solo lectura auditamos con un botón Supabase (RLS desactivada, políticas permisivas, funciones expuestas), Cloudflare (estado de la zona y tráfico en vivo: escaneos, herramientas de ataque, inundaciones) y tu código (claves filtradas, .env subidos, dependencias con CVE). Revisamos cada push, merge y pull request a main y avisamos por WhatsApp según la severidad que elijas, con botones que hacen algo real (te envían el arreglo o silencian el repo). Un pull request con un crítico queda en rojo y se cierra. Cada revisión se compara con la anterior para ver qué empeoró y qué se corrigió, y medimos el rendimiento de tu web con PageSpeed cuando quieras. Claude escribe un prompt de corrección por hallazgo y todo se exporta a cualquier IA con los secretos tapados. Un ZIP se analiza en el navegador sin que el código salga de tu equipo. La regla decide la alerta, no el modelo.",

  // Public URL where your project is deployed and running.
  // Must be a valid URL, for example: https://my-project.vercel.app
  // If your project is an app, put the download link here instead
  // (for example, a URL to download an APK).
  "deploy-url": "https://officialvanguard.com"
}
