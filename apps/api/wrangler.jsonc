// Worker principal de VanGUARD. Base del orquestador (name, routes, workers_dev, assets, vars);
// el BACK agrega main, bindings y crons. Los assets son todavía la página provisional de /site:
// cuando exista apps/web, "assets.directory" pasa a "../web/dist".
{
  "name": "vanguard",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-20",
  "compatibility_flags": ["nodejs_compat"],

  // Explícito: al declarar routes, Wrangler inferiría false y se perdería la URL de respaldo
  // https://vanguard.giovannizm14.workers.dev
  "workers_dev": true,
  "routes": [
    { "pattern": "officialvanguard.com", "custom_domain": true },
    { "pattern": "www.officialvanguard.com", "custom_domain": true }
  ],

  "assets": {
    "directory": "../../site"
  },

  "observability": {
    "enabled": true
  },

  // Variables no secretas: aquí y no en el panel, porque cada deploy reemplaza las del panel por estas.
  // VG_VERSION no va aquí: la pone el deploy command con --var a partir del commit.
  "vars": {
    "VG_ENV": "production",
    "APP_ORIGIN": "https://officialvanguard.com",
    // Demo por el sandbox de Kapso: E27 y el despachador no exigen la ventana de 24 h (el código de unión no llega
    // como message.received). Se quita al pasar al número real (kapso-config.mjs --real).
    "KAPSO_SANDBOX": "1"
  },

  // ── BACK: crons, cola y rate limits (S15 15.7, 15.8 y 15.3). Plan Workers Free: sin "limits" (no se pueden
  // subir), sin tail_consumers (no hay Tail Workers), sin R2 (el ZIP se abre en el navegador) y sin Workflow
  // (vg-scan solo si la prueba de humo de A7.7 lo aprueba).
  // Monitor por minuto · mantenimiento por hora · re-auditoría diaria (06:00 Caracas). Free: 5 por cuenta.
  "triggers": { "crons": ["* * * * *", "0 * * * *", "0 10 * * *"] },
  "queues": {
    "producers": [{ "binding": "JOBS_Q", "queue": "vg-jobs" }],
    "consumers": [
      // Un paso por invocación: 10 ms de CPU y <= 40 subpeticiones propias. El límite de cada paso lo aplica el código.
      { "queue": "vg-jobs", "max_batch_size": 1, "max_retries": 3, "dead_letter_queue": "vg-jobs-dlq" },
      // Cierre de la DLQ: paso failed con error_code 'dlq' y encola el siguiente.
      { "queue": "vg-jobs-dlq", "max_batch_size": 1 }
    ]
  },
  "ratelimits": [
    { "name": "RL_API", "namespace_id": "1001", "simple": { "limit": 300, "period": 60 } },
    { "name": "RL_COSTLY", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } },
    { "name": "RL_INGEST", "namespace_id": "1003", "simple": { "limit": 300, "period": 10 } },
    // Respuestas de E31 a un mismo teléfono (VERIFICAR con código malo): cada respuesta gasta cupo de WhatsApp.
    { "name": "RL_WA", "namespace_id": "1004", "simple": { "limit": 3, "period": 60 } }
  ]
}
