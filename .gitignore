
# Plan interno del equipo: nunca se publica (16.9)

# Caché local de las CLI de Cloudflare (cf, wrangler)
/.cloudflare/
.wrangler/
# El monorepo usa pnpm: otro lockfile confundiría a Workers Builds sobre qué gestor usar
package-lock.json
yarn.lock
node_modules/
dist/
coverage/
*.log
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*
!.dev.vars.example
*.pem
*.key
packages/deepwiki/out/

# Siembra de Rendimiento (plan §10.10): los LHR crudos de PSI no se versionan, solo el resumen
demo/perf-lhr/*
!demo/perf-lhr/resumen.json
# El repo víctima sí lleva su lockfile vulnerable (CB_DEP_VULN); el patrón global de arriba lo ignoraría
!demo/repo-vulnerable/package-lock.json
