+/** Qué hacer con un código de fallo: evento y nivel del log y si admite el reintento con la plantilla (solo 131047/470).
+ *  null = código sin tratamiento propio (queda en notifications.error y en el log genérico de quien llamó). */
+export function clasificarFallo(codigo: string | null | undefined): FalloKapso | null {
+  if (!codigo) return null;
+  return Object.hasOwn(FALLOS, codigo) ? FALLOS[codigo]! : codigo.startsWith('service_') ? SIN_SALDO : null;
+}
+
+/** Registra el fallo con su evento (nivel error lo que el equipo debe ver: cuenta restringida, sin saldo, número no
+ *  registrado, plantilla mal configurada). Solo el código y campos que no identifican a nadie. */
+export function registrarFallo(codigo: string | null | undefined, campos: Record<string, unknown> = {}): FalloKapso | null {
+  const f = clasificarFallo(codigo);
+  if (f) log(f.nivel, f.evento, { ...campos, code: codigo });
+  return f;
