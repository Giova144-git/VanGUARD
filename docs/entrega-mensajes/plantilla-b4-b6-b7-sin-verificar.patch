@@ -0,0 +1,107 @@
+import type { Severity } from '@vanguard/contracts';
+import { idBoton, paramsAlerta } from '@vanguard/core';
+import { filasBotones, nuevoNonce } from '../actions/approvals.ts';
+import type { db } from '../lib/db.ts';
+import { log } from '../lib/log.ts';
+import { cuerpoPlantilla, enmascararTelefono, enviarKapso, KapsoError, NOMBRE_PLANTILLA } from './kapso.ts';
+
+// Alerta de incidente con la plantilla aprobada de Meta (asignaciones/back-whatsapp-real.md B6 y B7): la que sale cuando
+// la ventana de 24 h está cerrada (despachador) o cuando Meta contesta 131047 a un interactivo (despachador en la
+// respuesta síncrona, E31 en el webhook failed). Su nombre lo pone el ORQUESTADOR en app_config cuando Meta la aprueba
+// como UTILITY; sin esa fila no se usa ninguna plantilla. La fila de notifications lleva template 'incident_tpl_v1': el
+// unique (incident_id, channel, recipient_masked, template) hace que salga una sola vez por incidente y contacto, y que
+// un reintento no pueda entrar en bucle. Subpeticiones: fila 1 + approvals 1 + envío ≤ 2 + cierre 1 = 5.
+
+type Obj = Record<string, unknown>;
+type Cliente = ReturnType<typeof db>;
+const obj = (x: unknown): Obj => (x && typeof x === 'object' && !Array.isArray(x) ? x as Obj : {});
+const str = (x: unknown): string | null => (typeof x === 'string' && x ? x : null);
+
+/** app_config.key con el nombre de la plantilla (value = '"alerta_seguridad_v1"'::jsonb). */
+export const CLAVE_PLANTILLA = 'kapso_plantilla_alerta';
+/** notifications.template de una alerta enviada con la plantilla (check ^[a-z0-9_]{3,40}$ de 0005). */
+export const TEMPLATE_PLANTILLA = 'incident_tpl_v1';
+/** Avisos de incidente que, si Meta los rechaza con 131047, se reintentan con la plantilla. */
+export const REINTENTABLES: ReadonlySet<string> = new Set(['incident_v1', 'incident_up_v1', 'reopened_v1', 'storm_v1']);
+
+/** Nombre de la plantilla configurada, o null si no hay fila, no tiene forma de nombre o la lectura falla (sin plantilla
+ *  no se envía nada fuera de la ventana). Una subpetición. Nunca lanza. */
+export async function leerPlantilla(admin: Cliente, rid: string): Promise<string | null> {
+  try {
+    const { data, error } = await admin.from('app_config').select('value').eq('key', CLAVE_PLANTILLA).maybeSingle();
+    if (error) {
+      log('warn', 'plantilla.lectura_error', { rid, code: error.code ?? null });
+      return null;
+    }
+    const v = obj(data).value;
+    return typeof v === 'string' && NOMBRE_PLANTILLA.test(v) ? v : null;
+  } catch (e) {
+    log('warn', 'plantilla.lectura_error', { rid, name: e instanceof Error ? e.name : typeof e });
+    return null;
+  }
+}
+
+export type IncidentePlantilla = { code: string; severity: Severity; rule_ids: readonly string[]; title: string | null };
+export type OrigenPlantilla = 'despacho' | 'reintento_sincrono' | 'reintento_webhook';
+export type ResultadoPlantilla =
+  | { estado: 'enviado'; provider_id: string; sent_at: string }
+  | { estado: 'ya_avisado' } | { estado: 'sin_fila' } | { estado: 'fallo'; error: string };
+
+// Código corto para notifications.error y el log: el de Meta/nuestro de KapsoError, nunca un mensaje del proveedor.
+const codigoError = (e: unknown) =>
+  (e instanceof KapsoError ? e.detalle ?? e.code : e instanceof RangeError ? 'invalid' : 'unavailable');
+
+/** Fila queued ANTES del envío (23505 = ya avisado con la plantilla: no sale nada), nonces nuevos de ack y snz con su
+ *  sha256 en approvals (como el interactivo), la plantilla con {{1}}–{{4}} de paramsAlerta y cierre a sent | failed solo
+ *  si la fila sigue queued. Si approvals falla, la plantilla sale igual (la alerta importa más que los botones: su canje
+ *  dará sin_canje). `phone` = E.164 de un contacto verificado: quien llama lo comprueba. Nunca lanza. */
+export async function enviarAlertaPlantilla(o: {
+  env: CloudflareBindings; admin: Cliente; orgId: string; incidentId: string; inc: IncidentePlantilla; phone: string;
+  nombre: string; rid: string; ahora: number; origen: OrigenPlantilla;
+}): Promise<ResultadoPlantilla> {
+  const { admin, orgId, rid } = o;
+  const recipient_masked = enmascararTelefono(o.phone);
+  const registro = { rid, incidente: o.inc.code, plantilla: TEMPLATE_PLANTILLA, recipient_masked, origen: o.origen };
+  try {
+    const { data, error } = await admin.from('notifications').insert({ org_id: orgId, incident_id: o.incidentId,
+      channel: 'whatsapp', template: TEMPLATE_PLANTILLA, recipient_masked, status: 'queued' }).select('id').single();
+    if (error?.code === '23505') {
+      log('info', 'plantilla.ya_avisado', registro);
+      return { estado: 'ya_avisado' };
+    }
+    const id = str(obj(data).id);
+    if (error || !id) {
+      // Sin fila no se envía: un WhatsApp real sin registro escaparía al tope por hora y E31 no tendría qué marcar.
+      log('warn', 'plantilla.sin_fila', { ...registro, code: error?.code ?? null });
+      return { estado: 'sin_fila' };
+    }
+
+    let cierre: { status: 'sent'; provider_id: string; sent_at: string } | { status: 'failed'; error: string };
+    try {
+      const nonces = { ack: nuevoNonce(), snz: nuevoNonce() };
+      // Valida código, nonces, nombre y parámetros antes de escribir approvals.
+      const mensaje = cuerpoPlantilla(o.phone, { nombre: o.nombre, idioma: 'es', params: paramsAlerta(o.inc),
+        payloads: [idBoton('ack', o.inc.code, nonces.ack), idBoton('snz', o.inc.code, nonces.snz)] });
+      const filas = await filasBotones({ org_id: orgId, incident_id: o.incidentId, recipient: o.phone.slice(1), nonces,
+        target: null, ahora: o.ahora });
+      const { error: ea } = await admin.from('approvals').insert(filas);
+      if (ea) log('warn', 'plantilla.sin_botones', { ...registro, code: ea.code ?? null });
+      const { provider_id } = await enviarKapso(o.env, mensaje);
+      cierre = { status: 'sent', provider_id, sent_at: new Date().toISOString() };
+    } catch (e) {
+      cierre = { status: 'failed', error: codigoError(e) };
+    }
+    const { error: ec } = await admin.from('notifications').update(cierre).eq('id', id).eq('org_id', orgId)
+      .eq('status', 'queued');
+    if (ec) log('warn', 'plantilla.sin_cierre', { ...registro, code: ec.code ?? null, status: cierre.status });
+    if (cierre.status === 'failed') {
+      log('warn', 'plantilla.envio_error', { ...registro, code: cierre.error });
+      return { estado: 'fallo', error: cierre.error };
+    }
+    log('info', 'plantilla.enviada', { ...registro, nombre: o.nombre });
+    return { estado: 'enviado', provider_id: cierre.provider_id, sent_at: cierre.sent_at };
+  } catch (e) {
+    log('error', 'plantilla.excepcion', { ...registro, name: e instanceof Error ? e.name : typeof e });
+    return { estado: 'fallo', error: 'unavailable' };
+  }
+}
