+const FALLOS: Readonly<Record<string, FalloKapso>> = (() => {
+  const t: Record<string, FalloKapso> = {};
+  const poner = (codigos: string[], f: FalloKapso) => { for (const c of codigos) t[c] = f; };
+  // 470 es el alias de la API antigua (no figura en la página de Cloud API).
+  poner(['131047', '470'], { evento: 'kapso.ventana_cerrada', nivel: 'warn', reintento: 'plantilla' });
+  poner(['132000', '132001', '132005', '132007', '132012', '132015', '132016', '132018'],
+    { evento: 'kapso.plantilla_error', nivel: 'error', reintento: null });
+  poner(['131026'], { evento: 'kapso.no_entregable', nivel: 'warn', reintento: null });
+  poner(['131049'], { evento: 'kapso.no_reintentar_24h', nivel: 'warn', reintento: null });
+  poner(['131056'], { evento: 'kapso.ritmo_par', nivel: 'warn', reintento: null });
+  poner(['368', '131031'], { evento: 'kapso.cuenta_restringida', nivel: 'error', reintento: null });
+  poner(['133010'], { evento: 'kapso.numero_no_registrado', nivel: 'error', reintento: null });
+  poner(['131042', '402', 'saldo'], { evento: 'kapso.sin_saldo', nivel: 'error', reintento: null });
