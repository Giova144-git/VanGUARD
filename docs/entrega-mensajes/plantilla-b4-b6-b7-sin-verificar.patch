+/** URL con esquema, www.… o algo con forma de dominio (acme.com): WhatsApp los vuelve enlace. */
+export const URL_EN_TEXTO = /\b(?:[a-z][a-z0-9+.-]*:\/\/|www\.)\S*|[\p{L}\p{N}_-]+(?:\.[\p{L}\p{N}_-]+)*\.[a-z]{2,}\b\S*/giu;
+export const quitarUrls = (s: string): string => String(s).replace(URL_EN_TEXTO, ' ');
+/** Tope de cada parámetro de la plantilla ({{3}} es el único largo: el título del incidente). */
+export const MAX_PARAM_PLANTILLA = 80;
+/** Parámetro de plantilla: sin caracteres de formato (bidi, ancho cero) ni URL, redactado, con IPv4 recortadas y en una
+ *  línea de ≤ max (Meta da 132018 a un parámetro con saltos, tabuladores o más de 4 espacios seguidos). Vacío si no
+ *  queda nada. */
+export function parametroPlantilla(s: string, max: number = MAX_PARAM_PLANTILLA): string {
+  const base = quitarUrls(String(s ?? '').slice(0, 1000).replace(/\p{Cf}/gu, ''));
+  return unaLinea(quitarUrls(textoSeguro(base, max)), max);
+}
+/** {{3}} cuando el título no deja nada utilizable. */
+export const TITULO_PLANTILLA_DEFECTO = 'Actividad sospechosa en tu servicio';
+/** Los 4 parámetros de alerta_seguridad_v1: {{1}} severidad en mayúsculas, {{2}} servicio, {{3}} título del incidente
+ *  (≤ 80, sin URL; nunca texto de la IA) y {{4}} INC-<código>. Deterministas: salen de la fila de incidents. */
+export type IncidenteParaPlantilla = { code: string; severity: Severity; rule_ids: readonly string[]; title?: string | null };
+export function paramsAlerta(i: IncidenteParaPlantilla): string[] {
+  return [severidadMayus(i.severity), servicioDeReglas(i.rule_ids),
+    parametroPlantilla(i.title ?? '', MAX_PARAM_PLANTILLA) || TITULO_PLANTILLA_DEFECTO, `INC-${codigoLimpio(i.code)}`];
+}
+/** Interactivo de seguimiento tras un toque en la plantilla, con el botón «Bloquear IP» (B6). */
